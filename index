  <div class="tooltip" id="tooltip"></div>

  <script>
    const metadata = {
      "Transformer": "Tags: architecture base | Empresa: Google | Fecha: 2017-06",
      "GPT-1": "Tags: pretrain | Empresa: OpenAI | Fecha: 2018-06",
      "GPT-2": "Tags: pretrain | Empresa: OpenAI | Fecha: 2019-02",
      "BERT": "Tags: pretrain, masked LM | Empresa: Google | Fecha: 2018-10",
      "RoBERTa": "Tags: retune | Empresa: Facebook | Fecha: 2019-07",
      "DistilBERT": "Tags: distillate | Empresa: Hugging Face | Fecha: 2019-10",
      "ALBERT": "Tags: parameter-shared | Empresa: Google | Fecha: 2019-12",
      "DeBERTa": "Tags: embedding-enhanced | Empresa: Microsoft | Fecha: 2020-02",
      "GPT-3": "Tags: pretrain | Empresa: OpenAI | Fecha: 2020-06",
      "mT5": "Tags: multilingual | Empresa: Google | Fecha: 2020-09",
      "LaMDA": "Tags: dialogue-tuned | Empresa: Google | Fecha: 2021-05",
      "Codex": "Tags: fine-tune (code) | Empresa: OpenAI | Fecha: 2021-08",
      "T0": "Tags: inst-tuned (P3) | Empresa: Hugging Face | Fecha: 2021-12",
      "InstructGPT": "Tags: fine-tune (RLHF) | Empresa: OpenAI | Fecha: 2022-01",
      "PaLM": "Tags: pretrain | Empresa: Google | Fecha: 2022-04",
      "OPT": "Tags: open-replica | Empresa: Meta | Fecha: 2022-05",
      "GPT-3.5": "Tags: fine-tune | Empresa: OpenAI | Fecha: 2022-11",
      "FLAN-T5": "Tags: inst-tuned (FLAN) | Empresa: Google | Fecha: 2022-12",
      "GPT-4": "Tags: pretrain+RLHF | Empresa: OpenAI | Fecha: 2023-03",
      "Claude-1": "Tags: RLHF from scratch | Empresa: Anthropic | Fecha: 2023-03",
      "LLaMA": "Tags: open pretrain | Empresa: Meta | Fecha: 2023-03",
      "Alpaca": "Tags: fine-tune (inst.) | Empresa: Stanford | Fecha: 2023-04",
      "Vicuna": "Tags: fine-tune (chat) | Empresa: LMSYS | Fecha: 2023-04",
      "PaLM 2": "Tags: updated pretrain | Empresa: Google | Fecha: 2023-05",
      "LLaMA 2": "Tags: improved pretrain | Empresa: Meta | Fecha: 2023-07",
      "Claude-2": "Tags: fine-tune | Empresa: Anthropic | Fecha: 2023-07",
      "Falcon-40B": "Tags: open pretrain | Empresa: TII | Fecha: 2023-07",
      "Claude Instant": "Tags: distilled/optimized | Empresa: Anthropic | Fecha: 2023-07",
      "CodeLLaMA": "Tags: code-tuned | Empresa: Meta | Fecha: 2023-08",
      "Falcon-180B": "Tags: scale-up | Empresa: TII | Fecha: 2023-09",
      "Mistral 7B": "Tags: inspired | Empresa: Mistral | Fecha: 2023-09",
      "Gemini": "Tags: merged multi-modal | Empresa: Google | Fecha: 2023-12",
      "Claude-3": "Tags: fine-tune | Empresa: Anthropic | Fecha: 2024-03",
      "Falcon 2": "Tags: multilingual tuned | Empresa: TII | Fecha: 2024-03",
      "Mamba7B": "Tags: new arch | Empresa: TII | Fecha: 2024-04",
      "GPT-4o": "Tags: multi-modal tuned | Empresa: OpenAI | Fecha: 2024-05",
      "Claude-4": "Tags: fine-tune | Empresa: Anthropic | Fecha: 2025-03",
      "Codex (ChatGPT+)": "Tags: fine-tune (code assist) | Empresa: OpenAI | Fecha: 2025-06"
    };

    const companyLogos = {
      "OpenAI": "https://raw.githubusercontent.com/simple-icons/simple-icons/develop/icons/openai.svg",
      "Google": "https://upload.wikimedia.org/wikipedia/commons/2/2f/Google_2015_logo.svg",
      "Meta": "https://upload.wikimedia.org/wikipedia/commons/thumb/7/7b/Meta_Platforms_Inc._logo.svg/800px-Meta_Platforms_Inc._logo.svg.png",
      "Microsoft": "https://upload.wikimedia.org/wikipedia/commons/4/44/Microsoft_logo.svg",
      "Hugging Face": "https://huggingface.co/front/assets/huggingface_logo-noborder.svg",
      "Anthropic": "https://assets-global.website-files.com/63e4c7b7b6b9b6b8c7e7e7e7/63e4c7b7b6b9b6b8c7e7e7e8_anthropic-logo.svg",
      "TII": "https://tii.ae/themes/custom/tii/logo.svg",
      "Stanford": "https://upload.wikimedia.org/wikipedia/commons/4/4a/Stanford_University_seal_2003.svg",
      "LMSYS": "https://lmsys.org/assets/logo.svg",
      "Mistral": "https://mistral.ai/favicon.svg"
    };

    let tooltip;
    
    // Función para obtener el texto del label basado en el círculo
    function getLabelFromCircle(circle) {
      // Estrategia 1: Buscar en el mismo grupo
      let group = circle.closest('g');
      
      if (group) {
        // Buscar diferentes tipos de selectores de texto
        const possibleSelectors = [
          '.commitLabel',
          'text',
          '.label',
          '[class*="label"]',
          '[class*="commit"]'
        ];
        
        for (let selector of possibleSelectors) {
          let label = group.querySelector(selector);
          if (label && label.textContent.trim()) {
            return label.textContent.trim();
          }
        }
      }
      
      // Estrategia 2: Buscar en grupos hermanos
      if (group && group.parentNode) {
        const siblings = group.parentNode.querySelectorAll('g');
        for (let sibling of siblings) {
          const siblingCircle = sibling.querySelector('circle');
          if (siblingCircle === circle) {
            // Encontramos el grupo correcto, buscar texto aquí
            const possibleSelectors = [
              '.commitLabel',
              'text',
              '.label',
              '[class*="label"]',
              '[class*="commit"]'
            ];
            
            for (let selector of possibleSelectors) {
              let label = sibling.querySelector(selector);
              if (label && label.textContent.trim()) {
                return label.textContent.trim();
              }
            }
          }
        }
      }
      
      // Estrategia 3: Buscar TODOS los elementos de texto, no solo .commitLabel
      const allTextElements = document.querySelectorAll('#graph text, #graph .commitLabel, #graph [class*="label"]');
      
      let closestLabel = null;
      let minDistance = Infinity;
      
      const circleRect = circle.getBoundingClientRect();
      const circleCenterX = circleRect.left + circleRect.width / 2;
      const circleCenterY = circleRect.top + circleRect.height / 2;
      
      allTextElements.forEach((textEl, index) => {
        const textContent = textEl.textContent.trim();
        if (!textContent) return;
        
        const textRect = textEl.getBoundingClientRect();
        const textCenterX = textRect.left + textRect.width / 2;
        const textCenterY = textRect.top + textRect.height / 2;
        
        const distance = Math.sqrt(
          Math.pow(circleCenterX - textCenterX, 2) + 
          Math.pow(circleCenterY - textCenterY, 2)
        );
        
        if (distance < minDistance && distance < 100) { // Límite de 100px
          minDistance = distance;
          closestLabel = textEl;
        }
      });
      
      return closestLabel ? closestLabel.textContent.trim() : null;
    }

    // Función para mostrar tooltip
    function showTooltip(e, text) {
      if (!tooltip) return;

      // Parsear el texto para crear un tooltip estructurado
      const parts = text.split(' | ');
      let tagsText = '';
      let companyText = '';
      let dateText = '';

      parts.forEach(part => {
        if (part.startsWith('Tags:')) {
          tagsText = part.replace('Tags: ', '');
        } else if (part.startsWith('Empresa:')) {
          companyText = part.replace('Empresa: ', '');
        } else if (part.startsWith('Fecha:')) {
          dateText = part.replace('Fecha: ', '');
        }
      });

      // Logo de la empresa
      let logoHTML = '';
      if (companyLogos[companyText]) {
        logoHTML = `<img src="${companyLogos[companyText]}" alt="${companyText} logo" class="tooltip-logo" />`;
      }

      // Crear HTML estructurado
      tooltip.innerHTML = `
        <div class="tooltip-company">${logoHTML}</div>
        <div class="tooltip-tags">${tagsText}</div>
        <div class="tooltip-date">${dateText}</div>
      `;

      tooltip.style.display = 'block';
      tooltip.style.left = (e.pageX + 15) + 'px';
      tooltip.style.top = (e.pageY - 30) + 'px';
    }

         // Función para ocultar tooltip
     function hideTooltip() {
       if (!tooltip) return;
       
       tooltip.style.display = 'none';
     }

    // Event delegation - captura eventos en el contenedor principal
    function setupEventDelegation() {
      const graphContainer = document.getElementById('graph');
      
             // Usar mouseover/mouseout en lugar de mouseenter/mouseleave para mejor captura
       graphContainer.addEventListener('mouseover', (e) => {
         if (e.target.tagName === 'circle') {
           const labelText = getLabelFromCircle(e.target);
           
           if (labelText && metadata[labelText]) {
             showTooltip(e, metadata[labelText]);
           }
         }
       });
       
       graphContainer.addEventListener('mouseout', (e) => {
         if (e.target.tagName === 'circle') {
           hideTooltip();
         }
       });
       
       graphContainer.addEventListener('mousemove', (e) => {
         if (e.target.tagName === 'circle' && tooltip && tooltip.style.display === 'block') {
           tooltip.style.left = (e.pageX + 15) + 'px';
           tooltip.style.top = (e.pageY - 30) + 'px';
         }
       });
    }

         document.addEventListener("DOMContentLoaded", () => {
       tooltip = document.getElementById("tooltip");
       
       // Configurar inmediatamente
       setupEventDelegation();
       
       // También intentar después de que Mermaid se cargue
       setTimeout(() => {
         const circles = document.querySelectorAll('#graph circle');
         
          // Forzar pointer-events en todos los círculos (solo para hover)
         circles.forEach((circle, index) => {
           circle.style.pointerEvents = 'all';
         });
       }, 1000);
       
       // Más intentos
       setTimeout(() => {
         setupEventDelegation();
       }, 2000);
     });
  </script>
</body>
</html>   
