  <link href="https://fonts.googleapis.com/css?family=Montserrat:600,700&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: Arial, sans-serif;
      padding: 20px;
      background-color: #f4f4f4;
    }
    .tooltip {
      position: absolute;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      color: #ffffff;
      padding: 12px 16px;
      border-radius: 12px;
      font-size: 0.85em;
      font-weight: 500;
      display: none;
      pointer-events: none;
      z-index: 10000;
      max-width: 280px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.12), 0 2px 8px rgba(0,0,0,0.08);
      border: 1px solid rgba(255,255,255,0.1);
      backdrop-filter: blur(10px);
      line-height: 1.4;
    }
    .tooltip-company {
      font-weight: 600;
      color: #ffd700;
      margin-bottom: 2px;
    }
    .tooltip-tags {
      opacity: 0.9;
      font-size: 0.8em;
    }
    .tooltip-date {
      opacity: 0.8;
      font-size: 0.75em;
      margin-top: 4px;
    }
    .mermaid svg circle {
      pointer-events: all !important;
    }
    .mermaid svg g {
      pointer-events: all !important;
    }
    .tooltip-logo {
      width: 32px;
      height: 32px;
      object-fit: contain;
      display: block;
      margin: 0 auto 6px auto;
      background: white;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.08);
      padding: 2px;
    }
    .commitLabel, .mermaid .commitLabel, .mermaid text.commitLabel {
      font-family: 'Montserrat', Arial, sans-serif !important;
      font-size: 1.25em !important; /* Ajusta el tamaño según lo que prefieras */
      font-weight: 700 !important;
      letter-spacing: 0.5px;
    }
    .mermaid #graph text {
      font-family: 'Montserrat', Arial, sans-serif !important;
      font-weight: 10000 !important;
    }
  </style>
</head>
<body>
